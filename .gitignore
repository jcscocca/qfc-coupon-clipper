# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store

# Logs produced by scheduled runs
*.log
logs/

# Local receipt ledger (contains personal purchase history).
data/receipt_savings.json
data/receipt_savings.json.tmp

